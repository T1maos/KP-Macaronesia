// =============================================================================
// plover_forward.slim — SLiM v3.6 Wright-Fisher forward simulation
// Lin et al., Methods "Individual-based forward simulations".
//
// Artificial diploid genome of 20,000 genes x 1,300 bp (Huber et al. 2017);
// mutation rate 2.03e-7 per site per generation; recombination among genes
// 1e-3 (Xie et al. 2022); deleterious:neutral ratio and gamma DFE from
// polyDFE (07_polydfe/); dominance h = 0 for s < -0.01 else h = 0.25
// (Kyriazis et al. 2021); demography from the best-supported fastsimcoal2
// model (manuscript Fig 3c / Fig S4); all parameters rescaled by a factor of
// 100 (SLiM manual). Per generation, 8 individuals (16 haploids) are sampled
// per population to track the N/S ratio; forward prediction covers the next
// 100,000 years at constant Ne.
// =============================================================================

initialize() {
    defineConstant("SCALE", 100);

    // genome: 20,000 genes x 1,300 bp; intergenic regions neutral
    defineConstant("N_GENES", 20000);
    defineConstant("GENE_LEN", 1300);
    defineConstant("MU", 2.03e-7);            // per site per generation (rescaled)
    defineConstant("R_GENE", 1e-3);           // recombination among genes
    initializeMutationRate(MU);

    // mutation types
    initializeMutationType("m1", 0.5, "f", 0.0);        // neutral (synonymous)
    m1.convertToSubstitution = T;
    // deleterious nonsynonymous class: gamma DFE from polyDFE
    // (mean s and shape multiplied/divided by the rescaling factor)
    defineConstant("S_BAR", -5.0e-2 * SCALE);   // mean s of the deleterious class
    defineConstant("DFE_SHAPE", 0.2);           // gamma shape parameter
    initializeMutationType("m2", 0.5, "g", S_BAR, DFE_SHAPE);
    m2.convertToSubstitution = T;

    // genomic elements
    defineConstant("P_DEL", 0.75);              // fraction nonsynonymous (polyDFE)
    initializeGenomicElementType("g1", c(m1, m2), c(1.0 - P_DEL, P_DEL));
    initializeGenomicElementType("g2", m1, 1.0); // intergenic

    // genome layout: genes back-to-back; recombination rate R_GENE at gene
    // boundaries, low uniform rate within genes
    ends = NULL; rates = NULL;
    pos = 0;
    for (i in 1:N_GENES) {
        initializeGenomicElement(g1, pos, pos + GENE_LEN - 1);
        ends = c(ends, pos + GENE_LEN - 1); rates = c(rates, 1e-8);
        pos = pos + GENE_LEN;
        ends = c(ends, pos - 1); rates = c(rates, R_GENE);
    }
    initializeRecombinationRate(rates, ends);
    initializeSex("A");
}

// dominance model: h = 0 when s < -0.01, h = 0.25 otherwise
// (threshold applied to the rescaled selection coefficient)
mutationEffect(m2) {
    s = mut.selectionCoeff;
    h = (s < -0.01 * SCALE) ? 0.0 : 0.25;
    if (homozygous)
        return 1.0 + s;
    else
        return 1.0 + h * s;
}

// demography from the best-supported fastsimcoal2 model (manuscript Fig 3c);
// Ne and split times are given in generations and rescaled by SCALE
defineConstant("N_ESP", 10000 / SCALE);   // Spain (mainland)
defineConstant("N_CAN",  2000 / SCALE);   // Canary
defineConstant("N_CAV",  1000 / SCALE);   // Cabo Verde
defineConstant("N_AZO",   200 / SCALE);   // Azores
defineConstant("T_CAN", 10000 / 2.5 / SCALE);  // Canary colonization
defineConstant("T_CAV",  2000 / 2.5 / SCALE);  // Cabo Verde colonization
defineConstant("T_AZO",   500 / 2.5 / SCALE);  // Azores colonization
defineConstant("T_BURNIN", 10 * N_ESP);        // burn-in (~10 Ne)
defineConstant("T_FORWARD", 100000 / 2.5 / SCALE);  // 100,000 yr forward

1 early() {
    sim.addSubpop("p1", asInteger(N_ESP));
    sim.rescheduleScriptBlock(sB1, start=T_BURNIN - T_CAN, end=T_BURNIN - T_CAN);
    sim.rescheduleScriptBlock(sB2, start=T_BURNIN - T_CAV, end=T_BURNIN - T_CAV);
    sim.rescheduleScriptBlock(sB3, start=T_BURNIN - T_AZO, end=T_BURNIN - T_AZO);
    sim.rescheduleScriptBlock(sOUT, start=T_BURNIN + 1, end=T_BURNIN + T_FORWARD);
}

sB1 10000 early() { sim.addSubpopSplit("p2", asInteger(N_CAN), p1); }  // Canary
sB2 10000 early() { sim.addSubpopSplit("p3", asInteger(N_CAV), p2); }  // Cabo Verde
sB3 10000 early() { sim.addSubpopSplit("p4", asInteger(N_AZO), p3); }  // Azores

// per generation: N/S ratio of 8 randomly sampled individuals per population
sOUT 10000 late() {
    for (pop in sim.subpopulations) {
        inds = sample(pop.individuals, 8);
        nonsyn = unique(inds.genomes.mutationsOfType(m2));
        syn    = unique(inds.genomes.mutationsOfType(m1));
        ns_ratio = size(nonsyn) / max(1, size(syn));
        catn(sim.cycle + "\t" + pop.id + "\t" + ns_ratio);
    }
}
