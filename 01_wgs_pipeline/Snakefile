# WGS resequencing pipeline — raw reads to joint genotyped, filtered SNP VCF
#
# Steps: FastQC → Trimmomatic → bwa-mem → Picard MarkDuplicates →
#        GATK HaplotypeCaller (gVCF per sample) → CombineGVCFs →
#        GenotypeGVCFs → SNP selection → hard filters (mark + exclude).
#
# Software versions: SOFTWARE.md (repository root).
# Usage:
#     1. edit config.yaml (reference genome path, sample IDs)
#     2. snakemake --cores 32

configfile: "config.yaml"

SAMPLES = config["samples"]            # sample IDs
REF     = config["reference"]          # reference genome FASTA

rule all:
    input:
        expand("results/qc/{s}_{r}_fastqc.html", s=SAMPLES, r=["1", "2"]),
        "results/vcf/joint.filtered.vcf.gz"

rule fastqc:
    input: fq="data/raw/{s}_{r}.fq.gz"
    output: "results/qc/{s}_{r}_fastqc.html"
    shell: "fastqc -o results/qc {input.fq}"

rule trim:
    input: r1="data/raw/{s}_1.fq.gz", r2="data/raw/{s}_2.fq.gz"
    output:
        r1="data/trim/{s}_1.clean.fq.gz", r2="data/trim/{s}_2.clean.fq.gz",
        u1="data/trim/{s}_1.unpaired.fq.gz", u2="data/trim/{s}_2.unpaired.fq.gz"
    log: "logs/trim/{s}.log"
    shell:
        "trimmomatic PE -threads 8 {input.r1} {input.r2} "
        "{output.r1} {output.u1} {output.r2} {output.u2} "
        "LEADING:20 TRAILING:20 SLIDINGWINDOW:5:20 MINLEN:36 2> {log}"

rule map:
    input: r1="data/trim/{s}_1.clean.fq.gz", r2="data/trim/{s}_2.clean.fq.gz"
    output: temp("results/bam/{s}.sorted.bam")
    threads: 16
    shell:
        "bwa mem -t {threads} -R '@RG\\tID:{wildcards.s}\\tSM:{wildcards.s}\\tPL:ILLUMINA' "
        "{REF} {input.r1} {input.r2} | samtools sort -o {output}"

rule dedup:
    input: "results/bam/{s}.sorted.bam"
    output: bam="results/bam/{s}.dedup.bam", metrics="results/qc/{s}.dup_metrics.txt"
    shell:
        "picard -Xmx16g MarkDuplicates I={input} O={output.bam} "
        "M={output.metrics} REMOVE_DUPLICATES=false && samtools index {output.bam}"

rule haplotypecaller:
    input: bam="results/bam/{s}.dedup.bam"
    output: "results/gvcf/{s}.g.vcf.gz"
    shell:
        "gatk HaplotypeCaller -R {REF} -I {input.bam} -O {output} -ERC GVCF"

rule combine:
    input: expand("results/gvcf/{s}.g.vcf.gz", s=SAMPLES)
    output: "results/vcf/cohort.g.vcf.gz"
    params: lambda w, input: " ".join(f"-V {v}" for v in input)
    shell: "gatk CombineGVCFs -R {REF} {params} -O {output}"

rule genotype:
    input: "results/vcf/cohort.g.vcf.gz"
    output: "results/vcf/joint.raw.vcf.gz"
    shell: "gatk GenotypeGVCFs -R {REF} -V {input} -O {output}"

rule hard_filter:
    input: "results/vcf/joint.raw.vcf.gz"
    output: filt="results/vcf/joint.filtered.vcf.gz"
    shell:
        "gatk SelectVariants -R {REF} -V {input} --select-type-to-include SNP "
        "-O results/vcf/joint.snps.vcf.gz && "
        "gatk VariantFiltration -R {REF} -V results/vcf/joint.snps.vcf.gz "
        "-O results/vcf/joint.marked.vcf.gz "
        "--filter-expression 'QD < 2.0' --filter-name QD2 "
        "--filter-expression 'FS > 60.0' --filter-name FS60 "
        "--filter-expression 'MQ < 40.0' --filter-name MQ40 "
        "--filter-expression 'MQRankSum < -12.5' --filter-name MQRS "
        "--filter-expression 'ReadPosRankSum < -8.0' --filter-name RPRS && "
        "gatk SelectVariants -R {REF} -V results/vcf/joint.marked.vcf.gz "
        "--exclude-filtered -O {output.filt}"

# Second-pass filters (VCFtools 0.1.17) are analysis-specific and applied by
# the downstream wrappers in 02_popgen/ and 03_demography/:
#   --min-alleles 2 --max-alleles 2 --minGQ 30 --min-meanDP 4 --max-meanDP 60
#   --max-missing 0.95 [--maf 0.1 except for SFS analyses]
